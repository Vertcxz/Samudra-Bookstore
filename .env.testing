APP_NAME="Laravel"
APP_ENV=testing
APP_KEY=base64:2UBWMvKCKdbhOm/dwfQr5BLWfq7QpmYufQtqGycW+WY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database khusus testing (pakai SQLite in memory)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Jangan pakai cache/queue/file session beneran saat testing
CACHE_DRIVER=array
SESSION_DRIVER=array
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Storage
FILESYSTEM_DISK=public

# Broadcast / Mail / dll cukup log saja
BROADCAST_DRIVER=log
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="testing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Lain-lain (opsional, biarkan default saja kalau tidak dipakai)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
